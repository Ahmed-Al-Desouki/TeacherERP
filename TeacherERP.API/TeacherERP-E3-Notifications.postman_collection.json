    {
      "name": "2 - جلب معرّفات الاختبار",
      "description": "بعد تسجيل الدخول، اعرض المجموعات والطلاب واختر مجموعة اختبار نشطة وطالبًا مناسبًا ثم عيّن المعرفات في Collection Variables.",
      "item": [
        {
          "name": "List teacher groups",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacherToken}}",
                "type": "text"
              },
              {
                "key": "X-Teacher-Id",
                "value": "{{tenantId}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/Groups?page=1&pageSize=50",
            "description": "انسخ groupId وtargetGroupId لمجموعتين نشطتين في tenantId نفسه."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));console.log(pm.response.json().items);"
                ]
              }
            }
          ]
        },
        {
          "name": "List students in group",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacherToken}}",
                "type": "text"
              },
              {
                "key": "X-Teacher-Id",
                "value": "{{tenantId}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/Students?groupId={{groupId}}&page=1&pageSize=50",
            "description": "انسخ studentId لطالب نشط. لتجربة طلبات الانضمام اختر مجموعات أخرى ليس الطالب عضوًا بها."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));console.log(pm.response.json().items);"
                ]
              }
            }
          ]
        }
      ]
