  "item": [
    {
      "name": "1 - تسجيل الدخول",
      "description": "املأ متغيرات الإيميل والباسورد في Collection Variables. دخول المساعد اختياري لبعض الأقسام.",
      "item": [
        {
          "name": "Login teacher",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/Auth/login",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{teacherEmail}}\",\n  \"password\": \"{{teacherPassword}}\",\n  \"deviceId\": \"{{$guid}}\",\n  \"deviceInfo\": \"Postman E3 test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login returned 200',()=>pm.response.to.have.status(200));const b=pm.response.json();const t=b.accessToken||b.AccessToken||b.data?.accessToken||b.value?.accessToken;pm.test('accessToken exists',()=>pm.expect(t).to.be.a('string').and.not.empty);pm.collectionVariables.set('teacherToken',t);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/Auth/login",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\",\n  \"deviceId\": \"{{$guid}}\",\n  \"deviceInfo\": \"Postman E3 test\"\n}",
