                  "pm.test('login returned 200',()=>pm.response.to.have.status(200));const b=pm.response.json();const t=b.accessToken||b.AccessToken||b.data?.accessToken||b.value?.accessToken;pm.test('accessToken exists',()=>pm.expect(t).to.be.a('string').and.not.empty);pm.collectionVariables.set('studentToken',t);"
