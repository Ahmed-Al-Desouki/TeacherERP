    {
      "name": "3 - قرارات طلبات الانضمام",
      "description": "المجموعتان يجب ألا يكون الطالب عضوًا فيهما. أرسل طلبًا وارفضه، ثم طلبًا آخر ووافق عليه.",
      "item": [
        {
          "name": "Student creates request to reject",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/Enrollment/requests",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groupId\": \"{{enrollmentRejectGroupId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('request created',()=>pm.response.to.have.status(200));pm.collectionVariables.set('enrollmentRejectRequestId',pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Teacher rejects request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacherToken}}",
                "type": "text"
              },
              {
                "key": "X-Teacher-Id",
                "value": "{{tenantId}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
