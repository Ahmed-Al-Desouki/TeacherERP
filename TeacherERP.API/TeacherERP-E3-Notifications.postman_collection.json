        {
          "name": "Move to target group",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacherToken}}",
                "type": "text"
              },
              {
                "key": "X-Teacher-Id",
