                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/Schedule/sessions/{{testSessionId}}/move",
            "description": "اختياري؛ المجموعة الهدف يجب أن تكون نشطة في نفس المساحة.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetGroupId\": \"{{targetGroupId}}\",\n  \"newStartTime\": \"{{testSessionStartUtc}}\",\n  \"durationMinutes\": 60,\n  \"confirmRoomConflicts\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('move succeeded',()=>pm.response.to.have.status(200));pm.collectionVariables.set('activeTestGroupId',pm.collectionVariables.get('targetGroupId'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Bulk shift test session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacherToken}}",
                "type": "text"
              },
              {
                "key": "X-Teacher-Id",
                "value": "{{tenantId}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/Schedule/sessions/bulk-shift",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from\": \"{{bulkFromUtc}}\",\n  \"to\": \"{{bulkToUtc}}\",\n  \"groupIds\": [\n    \"{{activeTestGroupId}}\"\n  ],\n  \"shiftMinutes\": 10,\n  \"confirmRoomConflicts\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('activeTestGroupId',pm.collectionVariables.get('activeTestGroupId')||pm.collectionVariables.get('groupId'));const d=new Date(pm.collectionVariables.get('testSessionStartUtc'));pm.collectionVariables.set('bulkFromUtc',new Date(d.getTime()-60000).toISOString());pm.collectionVariables.set('bulkToUtc',new Date(d.getTime()+7200000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('bulk shift succeeded',()=>pm.response.to.have.status(200));const d=new Date(pm.collectionVariables.get('testSessionStartUtc'));d.setMinutes(d.getMinutes()+10);pm.collectionVariables.set('testSessionStartUtc',d.toISOString());"
                ]
              }
            }
          ]
        },
