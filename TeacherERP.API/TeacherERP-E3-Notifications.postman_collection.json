    {
      "name": "2 - إشعارات الحصص",
      "description": "شغّل بالترتيب على مجموعة اختبار فقط. الحصة الإضافية ستبقى موجودة بعد التجربة.",
      "item": [
        {
          "name": "Create extra test session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacherToken}}",
                "type": "text"
              },
              {
                "key": "X-Teacher-Id",
                "value": "{{tenantId}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/Schedule/sessions",
            "description": "ينشئ حصة إضافية بعد 60 يومًا في وقت اختبار.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groupId\": \"{{groupId}}\",\n  \"startTime\": \"{{testSessionStartUtc}}\",\n  \"durationMinutes\": 60,\n  \"confirmRoomConflicts\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d=new Date(Date.now()+60*86400000);d.setUTCHours(2,15,0,0);pm.collectionVariables.set('testSessionStartUtc',d.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('session created',()=>pm.response.to.have.status(200));const b=pm.response.json();pm.collectionVariables.set('testSessionId',b.id||b.Id);pm.collectionVariables.set('testSessionStartUtc',b.startTime||b.StartTime);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reschedule test session",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacherToken}}",
                "type": "text"
              },
              {
                "key": "X-Teacher-Id",
                "value": "{{tenantId}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/Schedule/sessions/{{testSessionId}}/reschedule",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newStartTime\": \"{{rescheduleStartUtc}}\",\n  \"durationMinutes\": 60,\n  \"confirmRoomConflicts\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d=new Date(pm.collectionVariables.get('testSessionStartUtc'));d.setUTCHours(d.getUTCHours()+1);pm.collectionVariables.set('rescheduleStartUtc',d.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('reschedule succeeded',()=>pm.response.to.have.status(200));const b=pm.response.json();pm.collectionVariables.set('testSessionStartUtc',b.startTime||b.StartTime);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel test session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacherToken}}",
                "type": "text"
              },
              {
                "key": "X-Teacher-Id",
                "value": "{{tenantId}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/Schedule/sessions/{{testSessionId}}/cancel",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Postman E3 test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is successful',()=>pm.expect(pm.response.code).to.be.within(200,299));"
                ]
              }
            }
          ]
        },
